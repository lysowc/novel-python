# 复制为 .env 后按需修改
APP_ENV=local
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_novel
DB_USERNAME=root
DB_PASSWORD=root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# AI 任务队列名（与 PHP 版 worker 同时运行时可改为独立队列，如 ai:queue:py）
AI_QUEUE_KEY=ai:queue

# 定时续写按这个时区的时间触发
TIMEZONE=Asia/Shanghai

SESSION_SECRET=change-me
SESSION_SECURE=false
SESSION_SAME_SITE=lax

AI_HTTP_TIMEOUT=120
AI_TEMPERATURE=0.8

# 前端静态资源目录（Vue 构建产物）
STATIC_DIR=static
